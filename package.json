{
  "name": "dsh-cpa",
  "version": "0.2.4",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index-v024.mjs",
  "exports": {
    ".": "./lib/index-v024.mjs",
    "./client": "./lib/client-v024.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "description": "ChatGPT Codex authorization, quota, request metrics, USD estimates and in-memory SVG checks for DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M4rkzzz/dsh-cpa.git"
  },
  "homepage": "https://github.com/M4rkzzz/dsh-cpa#readme",
  "author": "M4rkzzz",
  "keywords": [
    "dsh-plugin",
    "chatgpt",
    "codex",
    "oauth",
    "quota"
  ],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs"
  }
}
