{
  "name": "dsh-cpa",
  "version": "0.2.6",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index-v026.mjs",
  "exports": {
    ".": "./lib/index-v026.mjs",
    "./client": "./lib/client-v026.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "description": "Isolated ChatGPT Codex accounts, real Fast transport, persistent request metadata and in-memory PNG checks for DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M4rkzzz/dsh-cpa.git"
  },
  "homepage": "https://github.com/M4rkzzz/dsh-cpa#readme",
  "author": "M4rkzzz",
  "keywords": [
    "dsh-plugin",
    "chatgpt",
    "codex",
    "oauth",
    "quota"
  ],
  "scripts": {
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "saxes": "6.0.0"
  }
}
